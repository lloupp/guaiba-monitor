{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "globals": {
    "L": "readonly",
    "leaflet": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn", { "args": "after-used", "argsIgnorePattern": "^_" }],
    "no-undef": "error",
    "no-redeclare": "error",
    "no-constant-condition": "warn",
    "no-dupe-keys": "error",
    "no-unreachable": "warn"
  }
}

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "checkJs": true,
    "allowJs": true,
    "outDir": "./dist",
    "rootDir": "./js",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["js/**/*.ts", "js/**/*.js"],
  "exclude": ["node_modules", "dist"]
}
